{
  "manifest_version": 3,
  "name": "OpenCockpit Bridge",
  "version": "2.0.0",
  "description": "Lets OpenCockpit drive the browser tabs you allow.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "scripting",
    "tabs",
    "tabGroups",
    "webNavigation",
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bubble-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OpenCockpit Bridge",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
